rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo dado de app (tasks, metais, usuarios, carros_chefe, fluxogramas,
    // breachos, leilao_*) migrou para bancos Neon Postgres dedicados,
    // acessados exclusivamente via API routes do Next.js com sessão JWT
    // verificada no servidor. O Firestore hoje serve só como backend do
    // Firebase Auth (customTokens mintados pelo próprio backend) — nenhum
    // código lê ou escreve nenhuma coleção de dados aqui.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
