rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // The backend creates custom tokens with the user's email as the UID.
    // If this assumption is wrong, replace request.auth.uid with request.auth.token.email.
    function isAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    // Tasks — authenticated users can read/create/update.
    // Only admins can delete directly (others must request deletion).
    match /tasks/{taskId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Delete requests — any auth user can create a request.
    // Only admins can approve (delete the request + the task).
    match /task_delete_requests/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Metals — any authenticated user can read and write.
    match /metais/{metalId} {
      allow read, write: if isAuth();
    }

    // Users — any auth user can read (needed for name resolution, etc.).
    // Only admins can create/update/delete user profiles and permissions.
    match /usuarios/{email} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Carros-chefe — any auth user can read. Only admins can modify.
    match /carros_chefe/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
